{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QQ 音乐 Lite",
  "version": "0.1.0",
  "identifier": "com.qmusic.lite",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": ".." },
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": { "script": "npm run build", "cwd": ".." },
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QQ 音乐 · Lite",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disk-cache-size=67108864 --media-cache-size=67108864"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; media-src 'self' https: blob: qmcache: http://qmcache.localhost; connect-src ipc: http://ipc.localhost https:",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; media-src 'self' https: blob: qmcache: http://qmcache.localhost; connect-src ipc: http://ipc.localhost https: ws://localhost:5273 http://localhost:5273"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": [],
    "publisher": "QMusic Light",
    "copyright": "个人学习与自用项目，与腾讯 / QQ 音乐无关",
    "shortDescription": "QQ 音乐 Lite",
    "longDescription": "轻量 QQ 音乐桌面客户端（个人学习自用）：扫码登录、歌单收藏、播放与歌词。",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "QQ 音乐 Lite"
      }
    }
  }
}
