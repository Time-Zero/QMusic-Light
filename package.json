{
  "name": "qmusic-light",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "QMusic Light · 轻量 QQ 音乐桌面客户端（Tauri 2 + React 19 + TypeScript 领域层）",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @qmusic/desktop",
    "build": "npm run build -w @qmusic/desktop",
    "preview": "npm run preview -w @qmusic/desktop",
    "typecheck": "npm run typecheck -w @qmusic/desktop",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "npm run tauri -w @qmusic/desktop --",
    "tauri:dev": "npm run tauri:dev -w @qmusic/desktop",
    "tauri:build": "npm run tauri:build -w @qmusic/desktop",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
